{
  "name": "@obliq/client",
  "version": "0.1.0",
  "description": "Official TypeScript and JavaScript client SDK for Obliq API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "obliq",
    "ocr",
    "document-processing",
    "sdk",
    "typescript",
    "client"
  ],
  "author": "Obliq Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^18.19.130",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
