# Application
APP_ENV=development
APP_NAME=obliq-api
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# API
API_V1_PREFIX=/v1
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES_PER_JOB=200
SYNC_PAGE_THRESHOLD=5
JOB_RESULT_TTL_SECONDS=3600
PROCESSING_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Database — Neon (serverless Postgres)
# ---------------------------------------------------------------------------
# Get the connection string from: https://console.neon.tech → your project → Connection Details
# Prefer the "Pooled connection" string for serverless / FastAPI Cloud.
# Example (replace with your real values):
# DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_xxxxxxxxxxxx@ep-cool-name-a1b2c3d4-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xxxxx-pooler.region.aws.neon.tech/neondb?ssl=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# ---------------------------------------------------------------------------
# Redis — Upstash (managed Redis)
# ---------------------------------------------------------------------------
# Get the Redis URL from: https://console.upstash.com → your database → REST API / Redis Connect
# Use the Redis protocol URL (starts with rediss:// for TLS).
# Example:
# REDIS_URL=rediss://default:ASxxAAIncDFmY2...@romantic-sheep-12345.upstash.io:6379
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
REDIS_JOB_PREFIX=obliq:job:
REDIS_RATE_PREFIX=obliq:rate:

# Credits
STARTING_CREDITS=10000
CREDITS_PER_PAGE=1

# Auth
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_PREFIX=obliq_live_
INTERNAL_KEY_PREFIX=obliq_internal_
BCRYPT_ROUNDS=12

# Rate limits (per key)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_PAGES_PER_MINUTE=120

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=obliq-api
